<!--
  MangaLens mark: a lens over a comic page, as a white silhouette.
  Used by the splash screen, the More/About header and notification icons,
  all of which need a single-colour shape. The file name is upstream's so the
  references stay untouched; only the artwork is ours (no Mihon branding left).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="256dp"
    android:height="256dp"
    android:viewportWidth="192"
    android:viewportHeight="192">

  <!-- Page outline -->
  <path
      android:fillColor="#FFFFFFFF"
      android:fillType="evenOdd"
      android:pathData="M20,14h56a10,10 0 0 1 10,10v104a10,10 0 0 1 -10,10h-56a10,10 0 0 1 -10,-10v-104a10,10 0 0 1 10,-10zM22,28v96h52v-96z"/>

  <!-- Panel divider -->
  <path
      android:fillColor="#FFFFFFFF"
      android:pathData="M22,72h52v8h-52z"/>

  <!-- Lens rim -->
  <path
      android:fillColor="#FFFFFFFF"
      android:fillType="evenOdd"
      android:pathData="M76,116a40,40 0 1 0 80,0a40,40 0 1 0 -80,0zM86,116a30,30 0 1 1 60,0a30,30 0 1 1 -60,0z"/>

  <!-- Translated lines inside the lens -->
  <path
      android:fillColor="#FFFFFFFF"
      android:pathData="M98,108h36v8h-36z"/>
  <path
      android:fillColor="#FFFFFFFF"
      android:pathData="M98,122h26v8h-26z"/>

  <!-- Handle -->
  <path
      android:pathData="M144,144L164,164"
      android:strokeColor="#FFFFFFFF"
      android:strokeWidth="16"
      android:strokeLineCap="round"/>
</vector>
